Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Serve real files (uploaded images) directly; route everything else to index.php.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Never expose config or SQL files.
<FilesMatch "\.(sql|md)$|^(config|database)\.php$">
    Require all denied
</FilesMatch>
