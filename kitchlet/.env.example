# Copy to .env.local (git-ignored) and fill in. Restart `npx expo start` after changes.

# Optional: only needed if the app can't find the XAMPP API automatically.
# EXPO_PUBLIC_API_URL=http://192.168.1.20/Kitchen-Utensils/api

# Spotify Web API — https://developer.spotify.com/dashboard
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=
EXPO_PUBLIC_SPOTIFY_CLIENT_SECRET=
# The song to feature: a track ID, spotify:track:… URI, or open.spotify.com/track/… link
EXPO_PUBLIC_SPOTIFY_TRACK_ID=
